# =============================================================================
# FMI Consolidated Environment Configuration (Single Root .env)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI Provider Credentials (Zero-Cost Dev Stack)
# -----------------------------------------------------------------------------
# LLM Brain: Google Gemini 2.0 Flash (Free tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=placeholder-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# STT: Groq Whisper Large v3 Turbo (Free tier at https://console.groq.com/keys)
GROQ_API_KEY=placeholder-groq-key
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# TTS: Local Kokoro-FastAPI (OpenAI-compatible speech endpoint)
TTS_PROVIDER=kokoro
KOKORO_API_URL=http://localhost:8880/v1
KOKORO_VOICE=af_heart

# VAD & Selection
VAD_PROVIDER=silero
STT_PROVIDER=groq_whisper
LLM_PROVIDER=gemini
AI_TRAINING_NOTICE_ACKNOWLEDGED=true

# -----------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Auth)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Frontend Supabase Mirrors (Vite reads VITE_*)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=placeholder-anon-key

# -----------------------------------------------------------------------------
# 3. LiveKit Realtime WebRTC Audio Server
# -----------------------------------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecretsecret

# Frontend LiveKit Mirror (Vite reads VITE_*)
VITE_LIVEKIT_WS_URL=ws://localhost:7880

# -----------------------------------------------------------------------------
# 4. Backend API & Services (FastAPI + Redis)
# -----------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_SECRET=agent-internal-secret-token

# Frontend API Base URL (Vite reads VITE_*)
VITE_API_BASE_URL=http://localhost:8000/api/v1
