# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LiveKit (Realtime Voice)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecretsecretsecret

# AI Providers (Zero-cost dev defaults)
# LLM: Gemini 2.0 Flash / Free Tier
GEMINI_API_KEY=your_gemini_api_key

# STT: Groq Whisper Large v3 Turbo
GROQ_API_KEY=your_groq_api_key

# TTS: Kokoro OpenAI-compatible endpoint or Piper
TTS_PROVIDER=kokoro
KOKORO_API_BASE=http://localhost:8880/v1
KOKORO_VOICE=af_heart

# API & Services
PORT=8000
VITE_API_URL=http://localhost:8000
VITE_LIVEKIT_URL=ws://localhost:7880

